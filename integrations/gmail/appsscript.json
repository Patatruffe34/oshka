{
  "timeZone": "Europe/Paris",
  "runtimeVersion": "V8",
  "exceptionLogging": "NONE",
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.message.readonly",
    "https://www.googleapis.com/auth/userinfo.email",
    "https://www.googleapis.com/auth/script.external_request"
  ],
  "urlFetchWhitelist": ["https://<project>.web.app/integrations/gmail/"],
  "addOns": {
    "common": {
      "name": "Oshka",
      "logoUrl": "https://<project>.web.app/icon-192.png",
      "layoutProperties": { "primaryColor": "#b83b28", "secondaryColor": "#b83b28" },
      "homepageTrigger": { "runFunction": "onGmailHomepage" },
      "openLinkUrlPrefixes": ["https://<project>.web.app/"]
    },
    "gmail": {
      "contextualTriggers": [{ "unconditional": {}, "onTriggerFunction": "onGmailMessageOpen" }]
    }
  }
}
