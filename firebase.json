{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/integrations/gmail/**", "function": { "functionId": "gmail", "region": "europe-west1" } },
      { "source": "/integrations/slack/**", "function": { "functionId": "slack", "region": "europe-west1" } },
      { "source": "/mcp", "function": { "functionId": "mcp", "region": "europe-west1" } },
      { "source": "/.well-known/oauth-*", "function": { "functionId": "mcp", "region": "europe-west1" } },
      { "source": "/.well-known/oauth-*/**", "function": { "functionId": "mcp", "region": "europe-west1" } },
      { "source": "/authorize", "function": { "functionId": "mcp", "region": "europe-west1" } },
      { "source": "/token", "function": { "functionId": "mcp", "region": "europe-west1" } },
      { "source": "/register", "function": { "functionId": "mcp", "region": "europe-west1" } },
      { "source": "/revoke", "function": { "functionId": "mcp", "region": "europe-west1" } },
      { "source": "/oauth/**", "function": { "functionId": "mcp", "region": "europe-west1" } },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/shortcuts/**",
        "headers": [
          { "key": "Content-Type", "value": "application/octet-stream" },
          { "key": "Content-Disposition", "value": "attachment; filename=\"Ajouter-a-Oshka.shortcut\"" },
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/@(index.html|sw.js|manifest.json|favicon.svg|logo.svg|icon-192.png|icon-512.png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["npm --prefix \"$PROJECT_DIR\" run build:functions"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
